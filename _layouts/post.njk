{% extends '_layouts/base.njk' %}

{% block meta %}
    <meta property="og:title" content="Hypogeum ※ {{ title }}">
{% endblock %}

{% block content %}
<main class="post">
    <article>
        <h1>{{ title }}</h1>
        {% if subtitle %}
            <h2 class="subtitle">{{ subtitle }}</h2>
        {% endif %}
        {{ content | safe }}
    </article>
    {% include 'patreon.njk' %}
</main>
{% endblock %}