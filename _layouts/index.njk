{% extends '_layouts/base.njk' %}

{% block content %}
<main class="index">
<section>

{% for post in collections.currentIssue %}
  <article>
    <h1>{{ post.data.title }}</h1>
    <p>
      {{ post.templateContent | excerpt(post.url) | safe }}
    </p>
  </article>
{% endfor %}

</section>
</main>
{% endblock %}
