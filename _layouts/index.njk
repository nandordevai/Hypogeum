{% extends '_layouts/base.njk' %}

{% block content %}
<main class="index">

{% for post in collections.currentIssue %}
  <article class="index__article {% if loop.first %}index__editorial{% endif %}">
    {# <h2 class="index__column">{{ post.data.column }}</h2> #}
    <h1 class="index__title"><a class="index__link" href="{{ post.url }}">{{ post.data.title }}</a></h1>
    {{ post.templateContent | excerpt(post.url) | safe }}
  </article>
{% endfor %}

</main>
{% endblock %}
