{% extends '_layouts/base.njk' %}

{% block content %}
<main class="index">

{% for post in collections.currentIssue %}
  <article class="index__article">
    <h1><a class="article-link" href="{{ post.url }}">{{ post.data.title }}</a></h1>
    {{ post.templateContent | excerpt(post.url) | safe }}
  </article>
{% endfor %}

</main>
{% endblock %}
