---
pagination:
    data: collections.post
    alias: posts
    size: 10
    reverse: true
---

{% extends '_layouts/base.njk' %}

{% block content %}
    {% include 'patreon.njk' %}
    {%- for post in posts -%}
        <article>
            <h1>{{ post.data.title }}</h1>
            {% if post.data.page.excerpt %}
                {% excerpt post %}
                <a href="{{ post.url }}">Read more</a>
            {% else %}
                {{ post.content | safe }}
            {% endif %}
            <p>
                <a class="permalink" href="{{ post.url }}">
                    <time datetime="{{ post.data.date.toISOString() }}">
                        {{ post.data.date.toLocaleString('en-GB', {
                            year: 'numeric', month: 'long', day: 'numeric', hour: 'numeric', minute: 'numeric'
                        }) }}</time>
                </a>
            </p>
            <p class="tags">
                {%- for tag in post.data.tags -%}
                    {% if tag != "post" %}
                        <span class="tag">{{ tag }}</span>
                    {% endif %}
                {%- endfor -%}
            </p>
        </article>
    {%- endfor -%}

    <nav class="footer">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}">Previous {{ pagination.size }}</a>
        {% else %}
            Previous {{ pagination.size }}
        {% endif %}
        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}">Next {{ pagination.size }}</a>
        {% else %}
            Next {{ pagination.size }}
        {% endif %}
    </nav>

{% endblock %}