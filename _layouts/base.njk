<!DOCTYPE html>
<html lang="hu">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Dark/ritual ambient, drone, industrial zenei website">
  <title>Hypogeum</title>
  <link rel="stylesheet" href="/main.css">
  <script src="/js/newsletter.js"></script>
  <meta property="og:image" content="https://hypogeum.hu/img/logo-black.png">
  {% block meta %}
  <meta property="og:title" content="Hypogeum ※ dark ambient // ritual // drone // industrial">
  {% endblock %}
</head>

<body>
  <header class="header">
    <div class="header__main">
      <h1 class="header__title">Hypogeum</h1>
      <h2 class="header__subtitle">dark ambient - ritual - drone - industrial</h2>
    </div>
    <nav class="header__menu menu">
      {%- for page in collections.menu -%}
        <a class="menu__item" href="{{ page.url }}">{{ page.data.title }}
          {%- if loop.first -%}
            Issue {{ currentIssue }}&nbsp;–&nbsp;{{ currentIssueDate | formatIssueDate }}
          {% endif %}
        </a>
        {% if not loop.last %}
          ※
        {% endif %}
      {%- endfor -%}
    </nav>
  </header>

  {% block content %}{% endblock %}

  <footer class="footer">
    <h2 class="footer__title">Hypogeum ※ dark ambient - ritual - drone - industrial</h2>
  </footer>
</body>

</html>